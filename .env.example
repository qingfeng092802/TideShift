# ==============================================================================
# 汐储 TideShift · 环境变量示例
# ------------------------------------------------------------------------------
# 用法：复制本文件为 .env 并填入真实值。
#   Windows:  copy .env.example .env
#   Linux/macOS:  cp .env.example .env
# .env 已被 .gitignore 排除，绝不会入库；所有变量均可留空，留空时使用默认值。
# ==============================================================================

# ---------- LLM 供应商 ----------
# 对话 Agent 与决策解释层使用的 API Key（也可在 Web 界面"模型设置"中配置，Key 加密落盘）
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# ---------- 服务监听 ----------
# FastAPI 监听地址/端口（默认 127.0.0.1:8800；公网部署改为 0.0.0.0 并置于反代之后）
ENERGY_HOST=127.0.0.1
ENERGY_PORT=8800
# uvicorn 日志级别：debug/info/warning/error
ENERGY_LOG_LEVEL=info

# ---------- 安全 ----------
# 首次启动管理员初始口令（不设置则生成随机口令并打印到控制台；首启后务必立即修改）
ADMIN_INITIAL_PASSWORD=
# 缓存签名密钥文件路径（默认 config/.cache_secret；生产建议挂载到独立密钥卷）
ENERGY_CACHE_SECRET_FILE=
# 认证与密钥落盘目录（默认 项目根/config/）。该目录存放 auth.json / .auth_secret / .api_secret，
# 可写状态建议放在代码目录之外（只读部署、容器挂载密钥卷）。pytest 会自动指向临时目录，
# 以免测试把凭据写进仓库工作树、进而让服务启动时忽略 ADMIN_INITIAL_PASSWORD。
ENERGY_CONFIG_DIR=
# SSRF 白名单逃生口：额外放行的 LLM 主机名（逗号分隔，仅自建网关时使用）
LLM_TEST_ALLOW_HOSTS=
